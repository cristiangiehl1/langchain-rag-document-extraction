# --- OpenRouter (chat/completion LLM) ---
OPENROUTER_API_KEY="sk-or-v1-..."
# Free model used for RAG answers. Override if the id changes on OpenRouter.
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_SITE_NAME="LangChain RAG Lab"

# --- Embeddings (HuggingFace Inference API) ---
# Remote API — no local model. Get a token at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN="hf_..."
# Multilingual model (384d) — good with Portuguese. Must stay 384-dim to match the
# vector(384) column. Use the "sentence-transformers/..." repo id (NOT "Xenova/...").
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# --- Database (pgvector) ---
# DEV — local Postgres via docker-compose (`npm run db:up`).
# The POSTGRES_* vars below are read by docker-compose, not by the app.
POSTGRES_USER="rag"
POSTGRES_PASSWORD="ragpass"
POSTGRES_DB="ragdb"
# Non-standard host port to avoid clashing with other local Postgres instances.
POSTGRES_PORT="5544"
DATABASE_URL="postgresql://rag:ragpass@localhost:5544/ragdb"

# PROD (Vercel + Supabase) — use the Transaction pooler URL from the Supabase
# dashboard (Project Settings > Database > Connection string > Transaction pooler).
# It looks like this (port 6543, serverless-friendly):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
