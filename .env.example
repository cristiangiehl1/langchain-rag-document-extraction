# --- OpenRouter (chat/completion LLM) ---
OPENROUTER_API_KEY="sk-or-v1-..."
# Free model used for RAG answers. Override if the id changes on OpenRouter.
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_SITE_NAME="LangChain RAG Lab"

# --- Local embeddings (transformers.js, runs on the server, no external API) ---
# Multilingual model (384d) — good with Portuguese. Must be a 384-dim model to
# match the vector(384) column; changing it requires re-embedding stored docs.
EMBEDDING_MODEL="Xenova/paraphrase-multilingual-MiniLM-L12-v2"

# --- Postgres + pgvector (matches docker-compose.yml) ---
POSTGRES_USER="rag"
POSTGRES_PASSWORD="ragpass"
POSTGRES_DB="ragdb"
# Non-standard host port to avoid clashing with other local Postgres instances.
POSTGRES_PORT="5544"
DATABASE_URL="postgresql://rag:ragpass@localhost:5544/ragdb"
